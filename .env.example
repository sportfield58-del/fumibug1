# .env.example — append-only (ver CLAUDE.md §6 / docs/spec/17-agentes.md §V.4).
# Nunca un valor real acá. Nunca reordenar este archivo.

# --- apps/api ---
NODE_ENV=development
PORT=3001

# --- packages/db ---
# Migraciones (prisma migrate / db:seed / db:studio): rol con permisos de owner/superuser
# sobre la base — nunca el que usa la API en runtime.
DATABASE_URL=postgresql://fumibug_migrator:CHANGEME@localhost:5432/fumibug_dev?schema=public
# Runtime de apps/api: rol fumibug_app, creado por la migración
# packages/db/prisma/migrations/20260821000001_partial_indexes_triggers_rls, SIN
# BYPASSRLS (docs/spec/11-seguridad.md §K.4). La contraseña se setea una sola vez, fuera
# de git, con `ALTER ROLE fumibug_app WITH PASSWORD '...'` — ver README.md.
APP_DATABASE_URL=postgresql://fumibug_app:CHANGEME@localhost:5432/fumibug_dev?schema=public

# --- apps/api: Supabase Auth (PR 5, docs/spec/11-seguridad.md §K.1) ---
# Verificación de JWT por JWKS cacheado (sin llamada a Supabase por request).
# En producción: SUPABASE_URL alcanza (JWKS e issuer se derivan de ahí).
# En desarrollo local sin Supabase: apuntar ambas al server de
# apps/api/scripts/dev-auth-server.mjs.
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_ISSUER=

# --- apps/api: observabilidad y transporte (PR 7, docs/spec/15-escalabilidad.md §R.2 /
# docs/spec/11-seguridad.md §K.9) ---
# Sin SENTRY_DSN, Sentry queda en no-op (desarrollo local / todavía no existe el proyecto).
SENTRY_DSN=
# CSV de orígenes permitidos para CORS. Nunca "*" (§K.9).
CORS_ALLOWED_ORIGINS=

# --- apps/web (PR 8/10) ---
# URL pública de la API deployada (Railway). Sin esto, apps/web/lib/api/client.ts cae a
# '/v1' relativo. Se setea como env var de Vercel, con el prefijo NEXT_PUBLIC_ obligatorio
# de Next.js para que llegue al bundle del navegador (nunca poner un secreto acá — es
# pública por definición, docs/spec/11-seguridad.md §K.8).
NEXT_PUBLIC_API_URL=


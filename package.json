{
  "name": "fumibug",
  "private": true,
  "version": "0.0.0",
  "description": "Fumibug — Field Service Management para control de plagas",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:tenant-isolation": "turbo run test:tenant-isolation",
    "test:e2e": "turbo run test:e2e",
    "generate": "turbo run generate",
    "db:migrate": "pnpm --filter @fumibug/db db:migrate",
    "db:seed": "pnpm --filter @fumibug/db db:seed",
    "db:studio": "pnpm --filter @fumibug/db db:studio",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@fumibug/config": "workspace:*",
    "turbo": "^2.1.3",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}

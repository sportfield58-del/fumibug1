{
  "name": "@fumibug/db",
  "private": true,
  "version": "0.1.0",
  "description": "schema.prisma, migraciones y seeds (docs/spec/08-modelo-datos.md). Cliente Prisma tipado, consumido solo por apps/api.",
  "main": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "echo \"packages/db: sin tests unitarios propios, ver test:integration\" && exit 0",
    "test:integration": "prisma migrate deploy && jest --config jest.integration.config.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0"
  },
  "devDependencies": {
    "@fumibug/config": "workspace:*",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.5",
    "eslint": "^9.12.0",
    "jest": "^29.7.0",
    "prisma": "^5.20.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
